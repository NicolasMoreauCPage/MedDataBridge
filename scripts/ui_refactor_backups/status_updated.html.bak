{% extends "base.html" %}
{% block content %}
<div class="max-w-4xl mx-auto py-8 px-4">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
    <a href="/" class="hover:text-blue-600 transition-colors">Accueil</a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <a href="/contracts" class="hover:text-blue-600 transition-colors">Contrats</a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <a href="/contracts/dossier/{{ contract.dossier_id }}" class="hover:text-blue-600 transition-colors">Dossier</a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-slate-700 font-medium">Statut mis à jour</span>
  </nav>

  <div class="bg-white rounded-lg shadow-lg p-6">
    <!-- Success message -->
    <div class="bg-blue-50 border border-blue-200 rounded-md p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-blue-800">Statut mis à jour</h3>
          <p class="mt-1 text-sm text-blue-700">
            Le statut du contrat a été modifié avec succès.
          </p>
        </div>
      </div>
    </div>

    <!-- Contract details -->
    <div class="border border-gray-200 rounded-lg p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Contrat mis à jour</h2>

      <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <dt class="text-sm font-medium text-gray-500">Type de contrat</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
              {% if contract.contract_type == 'NGAP' %}bg-blue-100 text-blue-800
              {% elif contract.contract_type == 'UCD' %}bg-green-100 text-green-800
              {% elif contract.contract_type == 'LPP' %}bg-purple-100 text-purple-800
              {% endif %}">
              {{ contract.contract_type }}
            </span>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Nouveau statut</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
              {% if contract.status == 'actif' %}bg-green-100 text-green-800
              {% elif contract.status == 'suspendu' %}bg-yellow-100 text-yellow-800
              {% elif contract.status == 'termine' %}bg-gray-100 text-gray-800
              {% endif %}">
              {{ contract.status.title() }}
            </span>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Date de début</dt>
          <dd class="mt-1 text-sm text-gray-900">{{ contract.date_debut.strftime('%d/%m/%Y') }}</dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Date de fin</dt>
          <dd class="mt-1 text-sm text-gray-900">
            {% if contract.date_fin %}
              {{ contract.date_fin.strftime('%d/%m/%Y') }}
            {% else %}
              Indéterminée
            {% endif %}
          </dd>
        </div>

        {% if contract.organisme_payeur %}
        <div>
          <dt class="text-sm font-medium text-gray-500">Organisme payeur</dt>
          <dd class="mt-1 text-sm text-gray-900">{{ contract.organisme_payeur }}</dd>
        </div>
        {% endif %}

        {% if contract.numero_contrat %}
        <div>
          <dt class="text-sm font-medium text-gray-500">Numéro de contrat</dt>
          <dd class="mt-1 text-sm text-gray-900">{{ contract.numero_contrat }}</dd>
        </div>
        {% endif %}

        {% if contract.taux_prise_en_charge %}
        <div>
          <dt class="text-sm font-medium text-gray-500">Taux de prise en charge</dt>
          <dd class="mt-1 text-sm text-gray-900">{{ contract.taux_prise_en_charge }}%</dd>
        </div>
        {% endif %}

        {% if contract.plafond_annuel %}
        <div>
          <dt class="text-sm font-medium text-gray-500">Plafond annuel</dt>
          <dd class="mt-1 text-sm text-gray-900">{{ "%.2f"|format(contract.plafond_annuel) }} €</dd>
        </div>
        {% endif %}
      </dl>
    </div>

    <!-- Actions -->
    <div class="flex justify-end gap-4 mt-6 pt-6 border-t">
      <a href="/contracts/dossier/{{ contract.dossier_id }}"
         class="px-6 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition-colors">
        Retour aux contrats
      </a>
    </div>
  </div>
</div>
{% endblock %}