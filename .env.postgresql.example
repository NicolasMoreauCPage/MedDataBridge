# PostgreSQL Database Configuration
# Copy this file to .env and update the values for your PostgreSQL instance

# Database type: postgresql or sqlite (default: sqlite)
DB_TYPE=postgresql

# PostgreSQL connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medbridge
DB_USER=medbridge
DB_PASSWORD=medbridge

# Session and security
SESSION_SECRET_KEY=your-secret-key-here-change-in-production

# Testing (set to 1 to use in-memory SQLite for tests)
TESTING=0

# MLLP Configuration
MLLP_TRACE=0

# Application
LOG_LEVEL=INFO
