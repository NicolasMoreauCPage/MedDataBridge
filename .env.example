# Configuration MedBridge - Variables d'environnement
# Copier ce fichier vers .env et ajuster les valeurs

# === APPLICATION ===
ENVIRONMENT=development  # development | staging | production
DEBUG=true
TESTING=false

# === SERVEUR ===
HOST=0.0.0.0
PORT=8000

# === BASE DE DONNÉES ===
# SQLite (dev)
DATABASE_URL=sqlite:///./data/medbridge.db
# PostgreSQL (prod) - exemple:
# DATABASE_URL=postgresql://user:password@localhost:5432/medbridge

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=60

# === SÉCURITÉ ===
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Ancienne clé de session (pour compatibilité)
SESSION_SECRET_KEY=your-session-secret-key-change-in-production

# === CORS ===
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
# Production: CORS_ORIGINS=["https://yourdomain.com"]

# === LOGGING ===
LOG_LEVEL=DEBUG  # DEBUG | INFO | WARNING | ERROR
LOGLEVEL=DEBUG  # Pour compatibilité

# === CACHE (Redis) ===
# REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# === MONITORING ===
ENABLE_METRICS=false
METRICS_PORT=9090

# === VALIDATION (HPRIM/PID13) ===
PID13_STRICT=1
PID13_ALLOW_USES=PH,Internet,CP
PID13_ALLOW_EQUIP=mineheure@free.fr,p.moreau@free.fr,mailperso@perso.fr,Victoria@gmail.com,CP_BOTRAUGIDE900018128346@mailsac.com,CP_BADERLE900018128545@mailsac.com,Josephine@gmail.com,Solene@outlook.fr,Agathe@gmail.com

# === BASE DE DONNÉES PRODUCTION ===
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=medbridge
# POSTGRES_USER=medbridge_user
# POSTGRES_PASSWORD=your_secure_password

# === EMAIL (optionnel) ===
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# === SERVICES EXTERNES ===
# FHIR_SERVER_URL=https://fhir-server.example.com
# HPRIM_ENDPOINT=https://hprim-service.example.com

# === TRACE MLLP (optionnel) ===
# MLLP_TRACE=0
