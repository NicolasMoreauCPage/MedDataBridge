{% extends "base.html" %}

{% block title %}Configuration scénarios - {{ ej.name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-6">
  <!-- Breadcrumb -->
  <nav class="flex items-center space-x-2 text-sm text-slate-600 mb-6">
    <a href="/" class="hover:text-blue-600 transition-colors">🏠 Accueil</a>
    <span class="text-slate-400">/</span>
    <span class="text-slate-800 font-medium"><i class="fas fa-cogs mr-2"></i>Configuration des scénarios</span>
  </nav>

  <!-- Header -->
  <div class="mb-8">
    <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 rounded-2xl p-8 text-white shadow-lg">
      <div class="flex items-center space-x-4">
        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
          <div class="text-3xl">📝</div>
        </div>
        <div>
          <h1 class="text-3xl font-bold"><i class="fas fa-cogs mr-2"></i>Configuration des scénarios</h1>
        </div>
      </div>
    </div>
  </div>

    <!-- Header -->
    <div class="mb-6">
        <a href="/config/scenario-ej" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 mb-2 inline-block">
            <i class="fas fa-arrow-left mr-1"></i>Retour à la liste
        </a>
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white">
            <i class="fas fa-cogs mr-2"></i>Configuration des scénarios
        </h1>
        <p class="text-gray-600 dark:text-gray-400 mt-1">
            Entité juridique: <strong>{{ ej.name }}</strong>
            {% if ej.identifier %}
            <span class="text-sm text-gray-500">({{ ej.identifier }})</span>
            {% endif %}
        </p>
    </div>

    <!-- Formulaire -->
    <form method="POST" action="/config/scenario-ej/{{ ej.id }}" class="space-y-8">
        
        <!-- UF Hospitalisation -->
        <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4 flex items-center">
                <span class="w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center mr-3">
                    <i class="fas fa-bed text-blue-600 dark:text-blue-400 text-sm"></i>
                </span>
                Hospitalisation
                <span class="ml-2 text-sm font-normal text-gray-500">(A01, A03, A11, A13)</span>
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Unité Fonctionnelle
                        </label>
                        <select name="uf_hospitalisation_id" 
                                class="uf-select w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <option value="">-- Sélectionner une UF --</option>
                            {% for uf in structure.all_ufs %}
                            <option value="{{ uf.id }}" 
                                    {% if config and config.uf_hospitalisation_id == uf.id %}selected{% endif %}>
                                {{ uf.path }}
                            </option>
                            {% endfor %}
                        </select>
                        <p class="mt-1 text-xs text-gray-500">UF utilisée pour les admissions en hospitalisation complète</p>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                Chambre <span class="text-xs text-gray-400">(optionnel)</span>
                            </label>
                            <input type="text" 
                                   name="chambre_hospitalisation" 
                                   id="chambre_hospitalisation"
                                   list="chambres_list_hosp"
                                   value="{{ config.chambre_hospitalisation if config else '' }}"
                                   maxlength="20"
                                   placeholder="Ex: 101 (saisie libre ou depuis liste)"
                                   class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <datalist id="chambres_list_hosp">
                                {% for uf in structure.all_ufs %}
                                    {% if uf.unites_hebergement %}
                                        {% for uh in uf.unites_hebergement.values() %}
                                            {% if uh.chambres %}
                                                {% for chambre in uh.chambres.values() %}
                                                    <option value="{{ chambre.name }}">{{ uf.path }} → {{ uh.name }} → {{ chambre.name }}</option>
                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            </datalist>
                            <p class="mt-1 text-xs text-gray-500">Optionnel - Pour hospitalisation confirmée uniquement</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                Lit <span class="text-xs text-gray-400">(optionnel)</span>
                            </label>
                            <input type="text" 
                                   name="lit_hospitalisation" 
                                   id="lit_hospitalisation"
                                   list="lits_list_hosp"
                                   value="{{ config.lit_hospitalisation if config else '' }}"
                                   maxlength="20"
                                   placeholder="Ex: A (saisie libre ou depuis liste)"
                                   class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <datalist id="lits_list_hosp">
                                {% for uf in structure.all_ufs %}
                                    {% if uf.unites_hebergement %}
                                        {% for uh in uf.unites_hebergement.values() %}
                                            {% if uh.chambres %}
                                                {% for chambre in uh.chambres.values() %}
                                                    {% if chambre.lits %}
                                                        {% for lit in chambre.lits %}
                                                            <option value="{{ lit.name }}">{{ chambre.name }} → {{ lit.name }}</option>
                                                        {% endfor %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            </datalist>
                            <p class="mt-1 text-xs text-gray-500">Optionnel - Pour hospitalisation confirmée avec chambre</p>
                        </div>
                    </div>
                </div>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Médecin responsable (RPPS)
                        </label>
                        <input type="text" name="medecin_hospitalisation_rpps" 
                               value="{{ config.medecin_hospitalisation_rpps if config else '' }}"
                               pattern="[0-9]{11}"
                               maxlength="11"
                               placeholder="Ex: 10101234567"
                               class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                        <p class="mt-1 text-xs text-gray-500">Numéro RPPS à 11 chiffres (PV1-7)</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Nom du médecin
                        </label>
                        <input type="text" name="medecin_hospitalisation_nom" 
                               value="{{ config.medecin_hospitalisation_nom if config else '' }}"
                               maxlength="100"
                               placeholder="Ex: DUPONT Jean"
                               class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                        <p class="mt-1 text-xs text-gray-500">Format: NOM Prénom</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- UF Consultation externe -->
        <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4 flex items-center">
                <span class="w-8 h-8 rounded-full bg-green-100 dark:bg-green-900 flex items-center justify-center mr-3">
                    <i class="fas fa-stethoscope text-green-600 dark:text-green-400 text-sm"></i>
                </span>
                Consultation externe
                <span class="ml-2 text-sm font-normal text-gray-500">(A04, A05, A38)</span>
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Unité Fonctionnelle
                        </label>
                        <select name="uf_consultation_id" 
                                class="uf-select w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <option value="">-- Sélectionner une UF --</option>
                            {% for uf in structure.all_ufs %}
                            <option value="{{ uf.id }}" 
                                    {% if config and config.uf_consultation_id == uf.id %}selected{% endif %}>
                                {{ uf.path }}
                            </option>
                            {% endfor %}
                        </select>
                        <p class="mt-1 text-xs text-gray-500">UF utilisée pour les consultations ambulatoires</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Salle de consultation <span class="text-xs text-gray-400">(optionnel)</span>
                        </label>
                        <input type="text" 
                               name="chambre_consultation" 
                               id="chambre_consultation"
                               list="chambres_list_consul"
                               value="{{ config.chambre_consultation if config else '' }}"
                               maxlength="20"
                               placeholder="Ex: CONS-A (saisie libre ou depuis liste)"
                               class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                        <datalist id="chambres_list_consul">
                            {% for uf in structure.all_ufs %}
                                {% if uf.unites_hebergement %}
                                    {% for uh in uf.unites_hebergement.values() %}
                                        {% if uh.chambres %}
                                            {% for chambre in uh.chambres.values() %}
                                                <option value="{{ chambre.name }}">{{ uf.path }} → {{ chambre.name }}</option>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </datalist>
                        <p class="mt-1 text-xs text-gray-500">Optionnel - Pas de lit pour consultations</p>
                    </div>
                </div>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Médecin consultant (RPPS)
                        </label>
                        <input type="text" name="medecin_consultation_rpps" 
                               value="{{ config.medecin_consultation_rpps if config else '' }}"
                               pattern="[0-9]{11}"
                               maxlength="11"
                               placeholder="Ex: 10101234567"
                               class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Nom du médecin
                        </label>
                        <input type="text" name="medecin_consultation_nom" 
                               value="{{ config.medecin_consultation_nom if config else '' }}"
                               maxlength="100"
                               placeholder="Ex: MARTIN Marie"
                               class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                    </div>
                </div>
            </div>
        </div>

        <!-- UF Urgences -->
        <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4 flex items-center">
                <span class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-900 flex items-center justify-center mr-3">
                    <i class="fas fa-ambulance text-red-600 dark:text-red-400 text-sm"></i>
                </span>
                Urgences
                <span class="ml-2 text-sm font-normal text-gray-500">(Passages urgences)</span>
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Unité Fonctionnelle
                        </label>
                        <select name="uf_urgences_id" 
                                class="uf-select w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <option value="">-- Sélectionner une UF --</option>
                            {% for uf in structure.all_ufs %}
                            <option value="{{ uf.id }}" 
                                    {% if config and config.uf_urgences_id == uf.id %}selected{% endif %}>
                                {{ uf.path }}
                            </option>
                            {% endfor %}
                        </select>
                        <p class="mt-1 text-xs text-gray-500">UF du service des urgences</p>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                Box <span class="text-xs text-gray-400">(optionnel)</span>
                            </label>
                            <input type="text" 
                                   name="chambre_urgences" 
                                   id="chambre_urgences"
                                   list="chambres_list_urg"
                                   value="{{ config.chambre_urgences if config else '' }}"
                                   maxlength="20"
                                   placeholder="Ex: BOX-1 (saisie libre ou depuis liste)"
                                   class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <datalist id="chambres_list_urg">
                                {% for uf in structure.all_ufs %}
                                    {% if uf.unites_hebergement %}
                                        {% for uh in uf.unites_hebergement.values() %}
                                            {% if uh.chambres %}
                                                {% for chambre in uh.chambres.values() %}
                                                    <option value="{{ chambre.name }}">{{ uf.path }} → {{ chambre.name }}</option>
                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            </datalist>
                            <p class="mt-1 text-xs text-gray-500">Optionnel</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                Brancard/Lit <span class="text-xs text-gray-400">(optionnel)</span>
                            </label>
                            <input type="text" 
                                   name="lit_urgences" 
                                   id="lit_urgences"
                                   list="lits_list_urg"
                                   value="{{ config.lit_urgences if config else '' }}"
                                   maxlength="20"
                                   placeholder="Ex: BR-01 (saisie libre ou depuis liste)"
                                   class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <datalist id="lits_list_urg">
                                {% for uf in structure.all_ufs %}
                                    {% if uf.unites_hebergement %}
                                        {% for uh in uf.unites_hebergement.values() %}
                                            {% if uh.chambres %}
                                                {% for chambre in uh.chambres.values() %}
                                                    {% if chambre.lits %}
                                                        {% for lit in chambre.lits %}
                                                            <option value="{{ lit.name }}">{{ chambre.name }} → {{ lit.name }}</option>
                                                        {% endfor %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </datalist>
                            <p class="mt-1 text-xs text-gray-500">Optionnel</p>
                        </div>
                    </div>
                </div>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Médecin urgentiste (RPPS)
                        </label>
                        <input type="text" name="medecin_urgences_rpps" 
                               value="{{ config.medecin_urgences_rpps if config else '' }}"
                               pattern="[0-9]{11}"
                               maxlength="11"
                               placeholder="Ex: 10101234567"
                               class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Nom du médecin
                        </label>
                        <input type="text" name="medecin_urgences_nom" 
                               value="{{ config.medecin_urgences_nom if config else '' }}"
                               maxlength="100"
                               placeholder="Ex: DURAND Pierre"
                               class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                    </div>
                </div>
            </div>
        </div>

        <!-- UF Mutation cible -->
        <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4 flex items-center">
                <span class="w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900 flex items-center justify-center mr-3">
                    <i class="fas fa-exchange-alt text-purple-600 dark:text-purple-400 text-sm"></i>
                </span>
                Mutation / Transfert
                <span class="ml-2 text-sm font-normal text-gray-500">(A02 - UF destination)</span>
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Unité Fonctionnelle (destination)
                        </label>
                        <select name="uf_mutation_cible_id" 
                                class="uf-select w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <option value="">-- Sélectionner une UF --</option>
                            {% for uf in structure.all_ufs %}
                            <option value="{{ uf.id }}" 
                                    {% if config and config.uf_mutation_cible_id == uf.id %}selected{% endif %}>
                                {{ uf.path }}
                            </option>
                            {% endfor %}
                        </select>
                        <p class="mt-1 text-xs text-gray-500">UF de destination pour les transferts internes</p>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                Chambre <span class="text-xs text-red-600">*</span>
                            </label>
                            <input type="text" 
                                   name="chambre_mutation" 
                                   id="chambre_mutation"
                                   list="chambres_list_mut"
                                   value="{{ config.chambre_mutation if config else '' }}"
                                   maxlength="20"
                                   placeholder="Ex: 201 (requis - destination du transfert)"
                                   class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <datalist id="chambres_list_mut">
                                {% for uf in structure.all_ufs %}
                                    {% if uf.unites_hebergement %}
                                        {% for uh in uf.unites_hebergement.values() %}
                                            {% if uh.chambres %}
                                                {% for chambre in uh.chambres.values() %}
                                                    <option value="{{ chambre.name }}">{{ uf.path }} → {{ chambre.name }}</option>
                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            </datalist>
                            <p class="mt-1 text-xs text-gray-500">Requis - Destination du transfert/mutation</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                Lit <span class="text-xs text-red-600">*</span>
                            </label>
                            <input type="text" 
                                   name="lit_mutation" 
                                   id="lit_mutation"
                                   list="lits_list_mut"
                                   value="{{ config.lit_mutation if config else '' }}"
                                   maxlength="20"
                                   placeholder="Ex: B (saisie libre ou depuis liste)"
                                   class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <datalist id="lits_list_mut">
                                {% for uf in structure.all_ufs %}
                                    {% if uf.unites_hebergement %}
                                        {% for uh in uf.unites_hebergement.values() %}
                                            {% if uh.chambres %}
                                                {% for chambre in uh.chambres.values() %}
                                                    {% if chambre.lits %}
                                                        {% for lit in chambre.lits %}
                                                            <option value="{{ lit.name }}">{{ chambre.name }} → {{ lit.name }}</option>
                                                        {% endfor %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                {% endif %}
                            {% endfor %}
                            </datalist>
                            <p class="mt-1 text-xs text-gray-500">Requis - Lit de destination du transfert</p>
                        </div>
                    </div>
                </div>                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Médecin destination (RPPS)
                        </label>
                        <input type="text" name="medecin_mutation_rpps" 
                               value="{{ config.medecin_mutation_rpps if config else '' }}"
                               pattern="[0-9]{11}"
                               maxlength="11"
                               placeholder="Ex: 10101234567"
                               class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Nom du médecin
                        </label>
                        <input type="text" name="medecin_mutation_nom" 
                               value="{{ config.medecin_mutation_nom if config else '' }}"
                               maxlength="100"
                               placeholder="Ex: LEROY Anne"
                               class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                    </div>
                </div>
            </div>
        </div>

        <!-- Médecin traitant (PV1-8) -->
        <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4 flex items-center">
                <span class="w-8 h-8 rounded-full bg-teal-100 dark:bg-teal-900 flex items-center justify-center mr-3">
                    <i class="fas fa-user-md text-teal-600 dark:text-teal-400 text-sm"></i>
                </span>
                Médecin traitant / Adressant
                <span class="ml-2 text-sm font-normal text-gray-500">(PV1-8 - commun à tous les scénarios)</span>
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        RPPS du médecin traitant
                    </label>
                    <input type="text" name="medecin_traitant_rpps" 
                           value="{{ config.medecin_traitant_rpps if config else '' }}"
                           pattern="[0-9]{11}"
                           maxlength="11"
                           placeholder="Ex: 10101234567"
                           class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                    <p class="mt-1 text-xs text-gray-500">Médecin qui adresse le patient (PV1-8)</p>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Nom du médecin traitant
                    </label>
                    <input type="text" name="medecin_traitant_nom" 
                           value="{{ config.medecin_traitant_nom if config else '' }}"
                           maxlength="100"
                           placeholder="Ex: BERNARD Sophie"
                           class="w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                    <p class="mt-1 text-xs text-gray-500">Format: NOM Prénom</p>
                </div>
            </div>
        </div>

        <!-- Boutons d'action -->
        <div class="flex justify-between items-center pt-4">
            <a href="/config/scenario-ej" 
               class="px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">
                <i class="fas fa-times mr-2"></i>Annuler
            </a>
            <button type="submit" 
                    class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                <i class="fas fa-save mr-2"></i>Enregistrer la configuration
            </button>
        </div>
    </form>
</div>

<script>
// Amélioration UX: filtrage des selects avec recherche
document.addEventListener('DOMContentLoaded', function() {
    // Si Select2 ou similar est disponible, l'utiliser
    const selects = document.querySelectorAll('.uf-select');
    selects.forEach(select => {
        // Ajouter un comportement de recherche basique si pas de librairie externe
        select.addEventListener('focus', function() {
            this.size = Math.min(10, this.options.length);
        });
        select.addEventListener('blur', function() {
            this.size = 1;
        });
        select.addEventListener('change', function() {
            this.size = 1;
            this.blur();
        });
    });
});
</script>

<style>
/* Style pour les selects avec recherche */
.uf-select {
    max-height: 300px;
}
.uf-select option {
    padding: 8px 12px;
}
.uf-select option:hover {
    background-color: #EBF5FF;
}
</style>
{% endblock %}
