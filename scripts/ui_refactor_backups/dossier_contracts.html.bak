{% extends "base.html" %}
{% block content %}
<div class="max-w-6xl mx-auto py-8 px-4">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
    <a href="/" class="hover:text-blue-600 transition-colors">Accueil</a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <a href="/contracts" class="hover:text-blue-600 transition-colors">Contrats</a>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-slate-700 font-medium">Dossier #{{ dossier.dossier_seq }}</span>
  </nav>

  <div class="btn">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Contrats du dossier</h1>
        <p class="text-gray-600 mt-1">Dossier #{{ dossier.dossier_seq }} - {{ dossier.patient.family }}, {{ dossier.patient.given }}</p>
      </div>
      <a href="/contracts/create/{{ dossier.id }}"
         class="btn btn-primary">
        Nouveau contrat
      </a>
    </div>

    <!-- Contrats actifs -->
    {% if active_contracts %}
    <div class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
        <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Contrats actifs
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for contract in active_contracts %}
        <div class="alert alert-success">
          <div class="flex justify-between items-start mb-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
              {{ contract.contract_type }}
            </span>
            <span class="text-sm text-green-600 font-medium">{{ contract.status.title() }}</span>
          </div>
          <div class="space-y-1 text-sm text-gray-600">
            <p><strong>Début:</strong> {{ contract.date_debut.strftime('%d/%m/%Y') }}</p>
            {% if contract.date_fin %}
            <p><strong>Fin:</strong> {{ contract.date_fin.strftime('%d/%m/%Y') }}</p>
            {% else %}
            <p><strong>Fin:</strong> Indéterminée</p>
            {% endif %}
            {% if contract.taux_prise_en_charge %}
            <p><strong>Taux:</strong> {{ contract.taux_prise_en_charge }}%</p>
            {% endif %}
            {% if contract.organisme_payeur %}
            <p><strong>Payeur:</strong> {{ contract.organisme_payeur }}</p>
            {% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <!-- Tous les contrats -->
    <div>
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Historique des contrats</h2>
      {% if contracts %}
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="btn">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Période</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Taux</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payeur</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="btn">
            {% for contract in contracts %}
            <tr class="{% if contract.status == 'actif' %}bg-green-50{% endif %}">
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                  {% if contract.contract_type == 'NGAP' %}bg-blue-100 text-blue-800
                  {% elif contract.contract_type == 'UCD' %}bg-green-100 text-green-800
                  {% elif contract.contract_type == 'LPP' %}bg-purple-100 text-purple-800
                  {% endif %}">
                  {{ contract.contract_type }}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="btn">
                  {{ contract.status.title() }}
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                {{ contract.date_debut.strftime('%d/%m/%Y') }}
                {% if contract.date_fin %}
                  - {{ contract.date_fin.strftime('%d/%m/%Y') }}
                {% else %}
                  - Indéterminée
                {% endif %}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                {% if contract.taux_prise_en_charge %}
                  {{ contract.taux_prise_en_charge }}%
                {% else %}
                  -
                {% endif %}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                {{ contract.organisme_payeur or '-' }}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                {% if contract.status == 'actif' %}
                <form method="post" action="/contracts/{{ contract.id }}/status" class="inline">
                  <input type="hidden" name="status" value="suspendu">
                  <button type="submit" class="text-yellow-600 hover:text-yellow-900 mr-2"
                          onclick="return confirm('Suspendre ce contrat ?')">
                    Suspendre
                  </button>
                </form>
                <form method="post" action="/contracts/{{ contract.id }}/status" class="inline">
                  <input type="hidden" name="status" value="termine">
                  <button type="submit" class="text-red-600 hover:text-red-900"
                          onclick="return confirm('Terminer ce contrat ?')">
                    Terminer
                  </button>
                </form>
                {% elif contract.status == 'suspendu' %}
                <form method="post" action="/contracts/{{ contract.id }}/status" class="inline">
                  <input type="hidden" name="status" value="actif">
                  <button type="submit" class="text-green-600 hover:text-green-900 mr-2"
                          onclick="return confirm('Réactiver ce contrat ?')">
                    Réactiver
                  </button>
                </form>
                <form method="post" action="/contracts/{{ contract.id }}/status" class="inline">
                  <input type="hidden" name="status" value="termine">
                  <button type="submit" class="text-red-600 hover:text-red-900"
                          onclick="return confirm('Terminer ce contrat ?')">
                    Terminer
                  </button>
                </form>
                {% else %}
                <span class="text-gray-400">Terminé</span>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">Aucun contrat</h3>
        <p class="mt-1 text-sm text-gray-500">Ce dossier n'a pas encore de contrats associés.</p>
        <div class="mt-6">
          <a href="/contracts/create/{{ dossier.id }}"
             class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
            Créer le premier contrat
          </a>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}