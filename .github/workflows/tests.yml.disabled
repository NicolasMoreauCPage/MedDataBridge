name: Tests

# Exécute les tests automatiquement sur push vers main et sur les pull requests
on:
  push:
    branches: [ main ]
    branches-ignore:
      - 'docs/**'
  pull_request:
    branches: [ main ]
    branches-ignore:
      - 'docs/**'

jobs:
  test:
    runs-on: ubuntu-latest
    
    steps:
    - name: 📥 Checkout code
      uses: actions/checkout@v4
    
    - name: 🐍 Setup Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'
        cache: 'pip'
    
    - name: 📦 Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt
    
    - name: 🧪 Run tests
      run: |
        pytest tests/test_identifier_generator.py -v --tb=short
    
    - name: ✅ Test summary
      if: always()
      run: |
        echo "Tests terminés !"
