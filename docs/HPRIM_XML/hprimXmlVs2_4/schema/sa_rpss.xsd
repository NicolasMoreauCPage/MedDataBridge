<?xml version="1.0" encoding="UTF-8"?>
<!-- auteur : Eric DUFOUR - INTEROPSANTE -->
<xsd:schema targetNamespace="http://www.hprim.org/hprimXML" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.hprim.org/hprimXML" elementFormDefault="qualified" attributeFormDefault="unqualified">
   <xsd:include schemaLocation="sa_professionnelsSante.xsd"/>
   <xsd:include schemaLocation="sa_pmsi.xsd"/>
   <xsd:complexType name="typeSequences">
      <xsd:sequence>
         <xsd:element name="sequence" type="typeSequence" maxOccurs="unbounded" />
      </xsd:sequence>
   </xsd:complexType>
   <xsd:complexType name="typeSequence">
      <xsd:sequence>
         <xsd:element name="dateAction" type="xsd:dateTime"/>
         <xsd:element name="acteurAction" type="typeProfessionnelSante" minOccurs="0"/>
         <xsd:element name="identifiant" type="typeIdentifiantPMSI"/>
         <xsd:element name="numeroSequence" type="nombre2"/>
         <xsd:element name="dates" type="typeDate"/>
         <xsd:element name="priseChargePrincipal" type="priseCharge" />
         <xsd:element name="priseChargeAssocie" type="priseCharge"/>
         <xsd:element name="indiceKarnofsky" type="typeIndiceKarnofsky"/>
         <xsd:element name="diagnosticPrincipal" type="typeDiagnostic"/>
         <xsd:element name="dependances" type="typeDependances"/>
         <xsd:element name="groupage" type="typeGroupageRpss" />
         <xsd:element name="rpss" type="typeSousSequence" maxOccurs="unbounded"/>
      </xsd:sequence>
      <xsd:attribute name="action" type="actionMiseAJour" use="required"/>
      <xsd:attribute name="version" type="attrVersionRpss" use="required"/>
   </xsd:complexType>

   <xsd:complexType name="typeDate">
      <xsd:sequence>
         <xsd:element name="entree" type="xsd:date"/>
         <xsd:element name="sortie" type="xsd:date"/>
      </xsd:sequence>
   </xsd:complexType>
   

   <xsd:complexType name="typeSousSequence">
      <xsd:sequence>
         <xsd:element name="numeroSousSequence" type="nombre2"/>
         <xsd:element name="dateEntree" type="xsd:date" />
         <xsd:element name="groupeHomogeneTarifs" type="typeGroupeHomogeneTarifs" />
      </xsd:sequence>

   </xsd:complexType>

   <xsd:simpleType name="priseCharge">
      <xsd:restriction base="xsd:positiveInteger">
         <xsd:maxExclusive value="26"/>
      </xsd:restriction>
  </xsd:simpleType>
   <xsd:simpleType name="typeIndiceKarnofsky">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="10"/>
         <xsd:enumeration value="20"/>
         <xsd:enumeration value="30"/>
         <xsd:enumeration value="40"/>
         <xsd:enumeration value="50"/>
         <xsd:enumeration value="60"/>
         <xsd:enumeration value="70"/>
         <xsd:enumeration value="80"/>
         <xsd:enumeration value="90"/>
         <xsd:enumeration value="100"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:complexType name="typeGroupageRpss">
      <xsd:sequence>
         <xsd:element name="ghpc" type="xsd:integer"/>
         <xsd:element name="codeErreur" type="xsd:integer"/>
      </xsd:sequence>
      <xsd:attribute name="version" type="attrVersionGroupeurRpss"/>
   </xsd:complexType>

   <xsd:complexType name="typeGroupeHomogeneTarifs">
      <xsd:sequence>
         <xsd:element name="groupeHomogeneTarif" type="typeGroupeHomogeneTarif" minOccurs="1" maxOccurs="4" />
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="typeGroupeHomogeneTarif">
      <xsd:sequence>
         <xsd:element name="numeroGHT" type="nombre2" />
         <xsd:element name="dateDebut" type="xsd:date" />
      </xsd:sequence>
   </xsd:complexType>


   <xsd:simpleType name="attrVersionGroupeurRpss">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="11"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="attrVersionRpss">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="01"/>
      </xsd:restriction>
   </xsd:simpleType>


 
</xsd:schema>
