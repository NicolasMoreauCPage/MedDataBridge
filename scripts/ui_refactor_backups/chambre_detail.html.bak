{% extends "base.html" %}

{% block title %}Chambre {{ chambre.name }}{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-6">
  <!-- Breadcrumb -->
  <nav class="flex items-center space-x-2 text-sm text-slate-600 mb-6">
    <a href="/" class="hover:text-blue-600 transition-colors">🏠 Accueil</a>
    <span class="text-slate-400">/</span>
    <span class="text-slate-800 font-medium">Chambre:</span>
  </nav>

  <!-- Header -->
  <div class="mb-8">
    <div class="bg-gradient-to-r from-purple-600 via-fuchsia-600 to-pink-600 rounded-2xl p-8 text-white shadow-lg">
      <div class="flex items-center space-x-4">
        <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3">
          <div class="text-3xl">📋</div>
        </div>
        <div>
          <h1 class="text-3xl font-bold">Chambre:</h1>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-gray-900">Chambre: {{ chambre.name }}</h2>
    <div class="space-x-2">
      <a href="/structure/chambres/{{ chambre.id }}/edit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">Modifier</a>
      <a href="/structure/uh/{{ chambre.unite_hebergement_id }}" class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">Retour UH</a>
    </div>
  </div>

  <div class="bg-white shadow rounded-md p-4 mb-8">
    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <dt class="text-sm font-medium text-gray-500">Identifiant</dt>
        <dd class="mt-1 text-sm text-gray-900">{{ chambre.identifier }}</dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Nom</dt>
        <dd class="mt-1 text-sm text-gray-900">{{ chambre.name }}</dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Description</dt>
        <dd class="mt-1 text-sm text-gray-900">{{ chambre.description or '-' }}</dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Unité d'Hébergement</dt>
        <dd class="mt-1 text-sm text-gray-900">{{ chambre.unite_hebergement.name if chambre.unite_hebergement else '-' }}</dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Type de Chambre</dt>
        <dd class="mt-1 text-sm text-gray-900">{{ chambre.type_chambre or '-' }}</dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Usage Genre</dt>
        <dd class="mt-1 text-sm text-gray-900">{{ chambre.gender_usage or '-' }}</dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Occupation Max</dt>
        <dd class="mt-1 text-sm text-gray-900">{{ chambre.max_occupancy or '-' }}</dd>
      </div>
      {{ inheritance_field(chambre, 'operational_status', 'Statut opérationnel') }}
      {{ inheritance_field(chambre, 'status', 'Statut') }}
      {{ inheritance_field(chambre, 'mode', 'Mode') }}
      {{ inheritance_field(chambre, 'physical_type', 'Type physique') }}
      {{ inheritance_field(chambre, 'etage', 'Étage') }}
      {{ inheritance_field(chambre, 'aile', 'Aile') }}
      {{ inheritance_field(chambre, 'opening_date', 'Date d\'ouverture', formatter='date') }}
      {{ inheritance_field(chambre, 'activation_date', 'Date d\'activation', formatter='date') }}
      {{ inheritance_field(chambre, 'closing_date', 'Date de fermeture', formatter='date') }}
      {{ inheritance_field(chambre, 'deactivation_date', 'Date de désactivation', formatter='date') }}
    </dl>
  </div>

  <h3 class="text-lg font-semibold mb-3">Lits</h3>
  <div class="bg-white shadow overflow-hidden sm:rounded-md">
    <ul role="list" class="divide-y divide-gray-200">
      {% for lit in lits %}
      <li>
        <a href="/structure/lits/{{ lit.id }}" class="block hover:bg-gray-50 px-4 py-4">
          <div class="flex items-center justify-between">
            <p class="text-sm font-medium text-indigo-600">{{ lit.name }}</p>
            <p class="text-sm text-gray-500">{{ lit.identifier }}</p>
          </div>
        </a>
      </li>
      {% else %}
      <li class="px-4 py-6 text-sm text-gray-500">Aucun lit</li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endblock %}
