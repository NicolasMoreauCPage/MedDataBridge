{%extends "base.html" %}

{%block content %}
<div class="max-w-4xl mx-auto px-4 py-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-sm text-slate-600 mb-6">
        <a href="/" class="hover:text-blue-600 transition-colors">🏠 Accueil</a>
        <span class="text-slate-400">/</span>
        <a href="/structure" class="hover:text-blue-600 transition-colors">Structure</a>
        <span class="text-slate-400">/</span>
        <span class="text-slate-800 font-medium">Pôle</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
        <div class="btn btn-primary">
            <div class="flex items-center space-x-4">
                <div class="btn">
                    <div class="text-3xl">🏢</div>
                </div>
                <div>
                    <h1 class="text-3xl font-bold">Modifier Pôle</h1>
                    <p class="text-white/80 mt-1">Édition des informations</p>
                </div>
            </div>
        </div>
    </div>

    <div class="btn">
        <div>
      <form action="/structure/poles/{{ pole.id }}" method="POST">
        <div class="shadow sm:overflow-hidden sm:rounded-md">
          <div class="btn">
            <div class="grid grid-cols-6 gap-6">
              <div class="col-span-6 sm:col-span-4">
                <label for="name" class="block text-sm font-medium text-gray-700">Nom</label>
                <input type="text" name="name" id="name" value="{{ pole.name }}" required
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
              </div>

              <div class="col-span-6 sm:col-span-4">
                <label for="identifier" class="block text-sm font-medium text-gray-700">Identifiant</label>
                <input type="text" name="identifier" id="identifier" value="{{ pole.identifier or '' }}"
                  class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
              </div>

              <div class="col-span-6 sm:col-span-4">
                <label for="entite_geo_id" class="block text-sm font-medium text-gray-700">Entité Géographique</label>
                <select id="entite_geo_id" name="entite_geo_id"
                  class="btn">
                  {% for eg in entites_geographiques %}
                  <option value="{{ eg.id }}" {{ 'selected' if pole.entite_geo_id == eg.id else '' }}>
                    {{ eg.name }}
                  </option>
                  {% endfor %}
                </select>
              </div>
            </div>
          </div>
          <div class="btn">
            <a href="/structure/poles/{{ pole.id }}" 
              class="btn">
              Annuler
            </a>
            <button type="submit"
              class="btn btn-primary">
              Enregistrer
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
  
</div>
{% endblock %}
