# Example environment file for validation settings
# Copy this to .env (or export variables) to enable strict PID-13 validation
# PID13_STRICT=1 enables strict checking of PID-13 (XTN) components (Use/Equipment)
# PID13_ALLOW_USES and PID13_ALLOW_EQUIP list comma-separated exceptions to accept

PID13_STRICT=1
PID13_ALLOW_USES=PH,Internet,CP
PID13_ALLOW_EQUIP=mineheure@free.fr,p.moreau@free.fr,mailperso@perso.fr,Victoria@gmail.com,CP_BOTRAUGIDE900018128346@mailsac.com,CP_BADERLE900018128545@mailsac.com,Josephine@gmail.com,Solene@outlook.fr,Agathe@gmail.com
# Configuration de l'application MedData Bridge
# Copiez ce fichier vers .env et remplissez les valeurs

# Clé secrète pour les sessions (OBLIGATOIRE)
# Générer avec: openssl rand -hex 32
SESSION_SECRET_KEY=votre_cle_secrete_ici

# Niveau de log (optionnel, DEBUG par défaut en développement)
# LOGLEVEL=DEBUG

# Mode test (optionnel, ne pas définir en production)
# TESTING=0

# Trace MLLP détaillée (optionnel)
# MLLP_TRACE=0
