<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ title }}{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="{{ url_for('static', path='/css/interface-testing.css') }}" rel="stylesheet">

    <style>
        .test-section {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
        }
        .result-success {
            background-color: #d1ecf1;
            border-color: #bee5eb;
            color: #0c5460;
        }
        .result-error {
            background-color: #f8d7da;
            border-color: #f5c6cb;
            color: #721c24;
        }
        .result-warning {
            background-color: #fff3cd;
            border-color: #ffeaa7;
            color: #856404;
        }
        .metric-card {
            text-align: center;
            padding: 1rem;
        }
        .metric-value {
            font-size: 2rem;
            font-weight: bold;
        }
        .metric-label {
            font-size: 0.9rem;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <nav class="bg-blue-600 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <a class="flex items-center text-white hover:text-blue-200 font-semibold" href="#">
                    <i class="fas fa-flask mr-2"></i> Tests d'Interfaces - MedData Bridge
                </a>
                <div class="flex space-x-4">
                    <a class="text-white hover:text-blue-200" href="/"><i class="fas fa-home mr-1"></i> Accueil</a>
                    <a class="text-white hover:text-blue-200" href="/metrics"><i class="fas fa-chart-line mr-1"></i> Métriques</a>
                    <a class="text-white hover:text-blue-200" href="/conformity"><i class="fas fa-check-circle mr-1"></i> Conformité</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="w-full">
            <h1 class="mb-4 text-2xl font-bold">
                <i class="fas fa-vial mr-2"></i> Dashboard de Tests d'Interfaces
            </h1>
                <p class="text-muted">
                    Outil de validation des interfaces d'interopérabilité pour GAM/GAP
                </p>
            </div>
        </div>

        <!-- Métriques de Conformité -->
        <div class="mb-4">
            <div class="bg-white rounded-lg shadow-md">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                    <h5 class="text-lg font-semibold text-gray-800">
                        <i class="fas fa-chart-bar mr-2"></i> Métriques de Conformité (7 derniers jours)
                    </h5>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4" id="compliance-metrics">
                        <div class="bg-blue-50 p-4 rounded-lg text-center">
                            <div class="text-2xl font-bold text-blue-600" id="total-messages">-</div>
                            <div class="text-sm text-gray-600">Messages Totaux</div>
                        </div>
                        <div class="bg-green-50 p-4 rounded-lg text-center">
                            <div class="text-2xl font-bold text-green-600" id="valid-rate">-</div>
                            <div class="text-sm text-gray-600">Taux de Validité</div>
                        </div>
                        <div class="bg-cyan-50 p-4 rounded-lg text-center">
                            <div class="text-2xl font-bold text-cyan-600" id="pam-compliant">-</div>
                            <div class="text-sm text-gray-600">Conformité PAM</div>
                        </div>
                        <div class="bg-yellow-50 p-4 rounded-lg text-center">
                            <div class="text-2xl font-bold text-yellow-600" id="avg-processing">-</div>
                            <div class="text-sm text-gray-600">Temps Moyen (ms)</div>
                        </div>
                    </div>
                    <button class="border border-blue-500 text-blue-500 hover:bg-blue-500 hover:text-white px-4 py-2 rounded font-medium mt-3" onclick="loadComplianceReport()">
                        <i class="fas fa-sync"></i> Actualiser
                    </button>
                </div>
            </div>
        </div>

        <!-- Test HL7 PAM -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white rounded-lg shadow-md p-6">
                <h4 class="text-lg font-semibold text-gray-800 mb-4">
                    <i class="fas fa-file-medical mr-2"></i> Validation HL7 PAM
                </h4>
                <form id="hl7-test-form">
                    <div class="mb-4">
                        <label for="hl7-message" class="block text-sm font-medium text-gray-700 mb-2">Message HL7</label>
                        <textarea
                            class="w-full border border-gray-300 rounded px-3 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                            id="hl7-message"
                            rows="8"
                            placeholder="Collez votre message HL7 ici..."
                        ></textarea>
                    </div>
                    <div class="mb-4">
                        <div class="flex items-center gap-2">
                            <input class="rounded border-gray-300" type="checkbox" id="validate-pam" checked>
                            <label class="text-sm text-gray-700" for="validate-pam">
                                Validation PAM complète
                            </label>
                        </div>
                    </div>
                    <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded font-medium">
                        <i class="fas fa-play"></i> Tester le Message
                    </button>
                </form>
                <div id="hl7-result" class="mt-4" style="display: none;"></div>
            </div>

            <!-- Test FHIR -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <h4 class="text-lg font-semibold text-gray-800 mb-4">
                    <i class="fas fa-file-code mr-2"></i> Validation FHIR Bundle
                </h4>
                <form id="fhir-test-form">
                    <div class="mb-4">
                        <label for="fhir-bundle" class="block text-sm font-medium text-gray-700 mb-2">Bundle FHIR (JSON)</label>
                        <textarea
                            class="w-full border border-gray-300 rounded px-3 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                            id="fhir-bundle"
                            rows="8"
                            placeholder='{"resourceType": "Bundle", "type": "transaction", ...}'
                        ></textarea>
                    </div>
                    <div class="mb-4">
                        <div class="flex items-center gap-2 mb-2">
                            <input class="rounded border-gray-300" type="checkbox" id="validate-references" checked>
                            <label class="text-sm text-gray-700" for="validate-references">
                                Valider les références
                            </label>
                        </div>
                        <div class="flex items-center gap-2">
                            <input class="rounded border-gray-300" type="checkbox" id="check-encounters" checked>
                            <label class="text-sm text-gray-700" for="check-encounters">
                                Vérifier les encounters
                            </label>
                        </div>
                    </div>
                    <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded font-medium">
                        <i class="fas fa-play"></i> Tester le Bundle
                    </button>
                </form>
                <div id="fhir-result" class="mt-4" style="display: none;"></div>
            </div>
            </div>
        </div>

        <!-- Test en Masse -->
        <div class="w-full">
            <div class="bg-white rounded-lg shadow-md p-6">
                <h4 class="text-lg font-semibold text-gray-800 mb-4">
                    <i class="fas fa-layer-group mr-2"></i> Tests en Masse de Scénarios
                </h4>
                <form id="bulk-test-form">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label for="scenario-ids" class="block text-sm font-medium text-gray-700">IDs des Scénarios</label>
                                <input
                                    type="text"
                                    class="border border-gray-300 rounded px-3 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                                    id="scenario-ids"
                                    placeholder="1,2,3,4,5"
                                >
                                <div class="text-xs text-gray-500">Séparés par des virgules</div>
                            </div>
                            <div>
                                <label for="concurrent-requests" class="block text-sm font-medium text-gray-700">Requêtes Concurrentes</label>
                                <input
                                    type="number"
                                    class="border border-gray-300 rounded px-3 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                                    id="concurrent-requests"
                                    value="5"
                                    min="1"
                                    max="20"
                                >
                            </div>
                            <div>
                                <label for="timeout" class="block text-sm font-medium text-gray-700">Timeout (secondes)</label>
                                <input
                                    type="number"
                                    class="border border-gray-300 rounded px-3 py-2 focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                                    id="timeout"
                                    value="30"
                                    min="5"
                                    max="300"
                                >
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded font-medium">
                                <i class="fas fa-play-circle"></i> Lancer les Tests en Masse
                            </button>
                        </div>
                    </form>
                    <div id="bulk-result" class="mt-3" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Charger le rapport de conformité au chargement
        document.addEventListener('DOMContentLoaded', function() {
            loadComplianceReport();
        });

        // Test HL7
        document.getElementById('hl7-test-form').addEventListener('submit', async function(e) {
            e.preventDefault();

            const message = document.getElementById('hl7-message').value;
            const validatePam = document.getElementById('validate-pam').checked;

            if (!message.trim()) {
                showResult('hl7-result', 'Erreur: Veuillez saisir un message HL7', 'error');
                return;
            }

            try {
                const response = await fetch('/api/interface-testing/hl7-pam-validation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        message: message,
                        validate_pam: validatePam
                    })
                });

                const result = await response.json();
                displayHL7Result(result);
            } catch (error) {
                showResult('hl7-result', `Erreur: ${error.message}`, 'error');
            }
        });

        // Test FHIR
        document.getElementById('fhir-test-form').addEventListener('submit', async function(e) {
            e.preventDefault();

            const bundleText = document.getElementById('fhir-bundle').value;
            const validateReferences = document.getElementById('validate-references').checked;
            const checkEncounters = document.getElementById('check-encounters').checked;

            if (!bundleText.trim()) {
                showResult('fhir-result', 'Erreur: Veuillez saisir un bundle FHIR', 'error');
                return;
            }

            try {
                const bundle = JSON.parse(bundleText);

                const response = await fetch('/api/interface-testing/fhir-bundle-validation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        bundle: bundle,
                        validate_references: validateReferences,
                        check_encounters: checkEncounters
                    })
                });

                const result = await response.json();
                displayFHIRResult(result);
            } catch (error) {
                showResult('fhir-result', `Erreur: ${error.message}`, 'error');
            }
        });

        // Test en masse
        document.getElementById('bulk-test-form').addEventListener('submit', async function(e) {
            e.preventDefault();

            const scenarioIdsText = document.getElementById('scenario-ids').value;
            const concurrentRequests = parseInt(document.getElementById('concurrent-requests').value);
            const timeout = parseInt(document.getElementById('timeout').value);

            if (!scenarioIdsText.trim()) {
                showResult('bulk-result', 'Erreur: Veuillez saisir des IDs de scénarios', 'error');
                return;
            }

            const scenarioIds = scenarioIdsText.split(',').map(id => parseInt(id.trim())).filter(id => !isNaN(id));

            if (scenarioIds.length === 0) {
                showResult('bulk-result', 'Erreur: Aucun ID de scénario valide', 'error');
                return;
            }

            try {
                const response = await fetch('/api/interface-testing/bulk-scenario-test', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        scenario_ids: scenarioIds,
                        concurrent_requests: concurrentRequests,
                        timeout_seconds: timeout
                    })
                });

                const result = await response.json();
                displayBulkResult(result);
            } catch (error) {
                showResult('bulk-result', `Erreur: ${error.message}`, 'error');
            }
        });

        // Fonctions utilitaires
        async function loadComplianceReport() {
            try {
                const response = await fetch('/api/interface-testing/compliance-report');
                const report = await response.json();

                document.getElementById('total-messages').textContent = report.total_messages;
                document.getElementById('valid-rate').textContent = `${((report.valid_messages / report.total_messages) * 100).toFixed(1)}%`;
                document.getElementById('pam-compliant').textContent = `${((report.pam_compliant_messages / report.total_messages) * 100).toFixed(1)}%`;
                document.getElementById('avg-processing').textContent = report.avg_processing_time;
            } catch (error) {
                console.error('Erreur lors du chargement du rapport:', error);
            }
        }

        function displayHL7Result(result) {
            let html = `
                <div class="${result.is_valid ? 'bg-green-100 border border-green-400 text-green-700' : 'bg-red-100 border border-red-400 text-red-700'} px-4 py-3 rounded">
                    <h6 class="font-semibold"><i class="fas ${result.is_valid ? 'fa-check-circle' : 'fa-exclamation-triangle'}"></i>
                        ${result.is_valid ? 'Message Valide' : 'Erreurs Détectées'}</h6>
                    <p><strong>Temps de traitement:</strong> ${result.processing_time_ms} ms</p>
            `;

            if (result.message_type) {
                html += `<p><strong>Type de message:</strong> ${result.message_type}`;
                if (result.trigger_event) {
                    html += ` (${result.trigger_event})`;
                }
                html += '</p>';
            }

            if (result.errors.length > 0) {
                html += '<h6>Erreurs:</h6><ul>';
                result.errors.forEach(error => {
                    html += `<li>${error}</li>`;
                });
                html += '</ul>';
            }

            if (result.warnings.length > 0) {
                html += '<h6>Avertissements:</h6><ul>';
                result.warnings.forEach(warning => {
                    html += `<li>${warning}</li>`;
                });
                html += '</ul>';
            }

            html += '</div>';
            showResult('hl7-result', html, result.is_valid ? 'success' : 'error');
        }

        function displayFHIRResult(result) {
            let html = `
                <div class="${result.is_valid ? 'bg-green-100 border border-green-400 text-green-700' : 'bg-red-100 border border-red-400 text-red-700'} px-4 py-3 rounded">
                    <h6 class="font-semibold"><i class="fas ${result.is_valid ? 'fa-check-circle' : 'fa-exclamation-triangle'}"></i>
                        ${result.is_valid ? 'Bundle Valide' : 'Erreurs Détectées'}</h6>
                    <p><strong>Temps de traitement:</strong> ${result.processing_time_ms} ms</p>
                    <p><strong>Ressources:</strong> ${result.resource_count}</p>
                    <p><strong>Patients:</strong> ${result.patient_count} | <strong>Encounters:</strong> ${result.encounter_count}</p>
            `;

            if (result.errors.length > 0) {
                html += '<h6>Erreurs:</h6><ul>';
                result.errors.forEach(error => {
                    html += `<li>${error}</li>`;
                });
                html += '</ul>';
            }

            if (result.warnings.length > 0) {
                html += '<h6>Avertissements:</h6><ul>';
                result.warnings.forEach(warning => {
                    html += `<li>${warning}</li>`;
                });
                html += '</ul>';
            }

            html += '</div>';
            showResult('fhir-result', html, result.is_valid ? 'success' : 'error');
        }

        function displayBulkResult(result) {
            let html = `
                <div class="${result.failed_tests === 0 ? 'bg-green-100 border border-green-400 text-green-700' : 'bg-yellow-100 border border-yellow-400 text-yellow-700'} px-4 py-3 rounded">
                    <h6 class="font-semibold"><i class="fas fa-chart-bar"></i> Résultats des Tests en Masse</h6>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-2">
                        <div>
                            <strong>Scénarios testés:</strong> ${result.total_scenarios}
                        </div>
                        <div>
                            <strong>Réussis:</strong> ${result.successful_tests}
                        </div>
                        <div>
                            <strong>Échoués:</strong> ${result.failed_tests}
                        </div>
                        <div>
                            <strong>Temps moyen:</strong> ${result.avg_response_time} ms
                        </div>
                    </div>
            `;

            if (result.errors.length > 0) {
                html += '<h6>Erreurs:</h6><ul>';
                result.errors.slice(0, 10).forEach(error => {
                    html += `<li>${error}</li>`;
                });
                if (result.errors.length > 10) {
                    html += `<li>... et ${result.errors.length - 10} autres erreurs</li>`;
                }
                html += '</ul>';
            }

            html += '</div>';
            showResult('bulk-result', html, result.failed_tests === 0 ? 'success' : 'warning');
        }

        function showResult(elementId, content, type) {
            const element = document.getElementById(elementId);
            element.innerHTML = content;
            element.style.display = 'block';

            // Scroll to result
            element.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    </script>
</body>
</html>