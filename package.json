{
  "name": "meddata_bridge",
  "version": "1.1.0",
  "description": "Plateforme de qualification et de test d'interopérabilité HL7, IHE PAM, HPRIM et FHIR.",
  "private": true,
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {},
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.13.0",
    "daisyui": "^5.5.14",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  },
  "scripts": {
    "build-css": "tailwindcss -i ./app/static/css/main.css -o ./app/static/css/output.css --watch",
    "build-css-prod": "tailwindcss -i ./app/static/css/main.css -o ./app/static/css/output.css --minify",
    "lint": "node scripts/lint_frontend.mjs",
    "inventory-assets": "node scripts/inventory_frontend_assets.mjs",
    "check-budgets": "node scripts/check_frontend_budgets.mjs",
    "test": "node --test tests/frontend/*.test.mjs",
    "check-frontend": "npm run lint && npm test && npm run inventory-assets && npm run build-css-prod && npm run check-budgets"
  },
  "license": "MIT"
}
